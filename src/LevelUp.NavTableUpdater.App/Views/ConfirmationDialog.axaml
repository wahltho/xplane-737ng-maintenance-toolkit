<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:LevelUp.NavTableUpdater.App.Services"
        x:Class="LevelUp.NavTableUpdater.App.Views.ConfirmationDialog"
        x:DataType="services:ConfirmationRequest"
        Width="560"
        SizeToContent="Height"
        MinHeight="240"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppSurfaceBrush}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14" Margin="24">
        <TextBlock Text="{Binding Title}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Row="1"
                   Text="{Binding Message}"
                   FontSize="14"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                   TextWrapping="Wrap"/>

        <Border Grid.Row="2" x:Name="UnofficialNotice"
                IsVisible="{Binding RequiresUnofficialAcknowledgement}"
                Background="#3D1118" BorderBrush="#E55C65" BorderThickness="1"
                CornerRadius="5" Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="UNOFFICIAL ZIBO AIRCRAFT CHANGE"
                           FontWeight="Bold" Foreground="#FF8B93"/>
                <TextBlock Text="These files are not part of the official Zibo Mod release and may be overwritten by a later official update. Zibo, Skymatix and official Zibo channels do not support these changes."
                           Foreground="#FFFFFF" TextWrapping="Wrap"/>
                <Button Content="{Binding IndependentProjectLabel}"
                        HorizontalAlignment="Left" FontWeight="Bold"
                        Foreground="#FFFFFF" Background="#3D1118"
                        BorderBrush="#E55C65" BorderThickness="1"
                        Click="OpenProject_Click"/>
                <CheckBox x:Name="UnofficialAcknowledgement"
                          Content="I understand this is an independent change and will use the project page for feedback."
                          Foreground="#FFFFFF" IsChecked="False" Click="Acknowledgement_Changed"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">
            <Button Content="{Binding CancelText}"
                    MinWidth="100"
                    IsVisible="{Binding ShowCancel}"
                    Click="Cancel_Click"/>
            <Button x:Name="ConfirmButton" Content="{Binding ConfirmText}"
                    MinWidth="130"
                    Background="{DynamicResource AppPrimaryBrush}"
                    Foreground="{DynamicResource AppPrimaryForegroundBrush}"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
