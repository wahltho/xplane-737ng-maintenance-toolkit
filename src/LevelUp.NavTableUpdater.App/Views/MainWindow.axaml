<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LevelUp.NavTableUpdater.App.ViewModels"
        xmlns:core="using:LevelUp.NavTableUpdater.Core"
        xmlns:analysis="using:LevelUp.NavTableUpdater.Core.Analysis"
        xmlns:aircraft="using:LevelUp.NavTableUpdater.Core.Aircraft"
        xmlns:content="using:LevelUp.NavTableUpdater.Core.Content"
        xmlns:upstream="using:LevelUp.NavTableUpdater.Core.Upstream"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="780"
        x:Class="LevelUp.NavTableUpdater.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="X-Plane 737NG Maintenance Toolkit"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="680">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource AppInputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}"/>
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
        </Style>
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="Border.status-card">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="Border.task-card">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="MinHeight" Value="210"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForegroundBrush}"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource AppSecondaryButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryButtonForegroundBrush}"/>
        </Style>
        <Style Selector="Border.path-display">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="TextBlock.path">
            <Setter Property="FontFamily" Value="Menlo,Consolas,monospace"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.secondary-path">
            <Setter Property="FontFamily" Value="Menlo,Consolas,monospace"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.operation-card">
            <Setter Property="Background" Value="#160A3D"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style Selector="Border.console-card">
            <Setter Property="Background" Value="#10072C"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource AppBackgroundBrush}">
        <Border Grid.Row="0" Background="{DynamicResource AppHeaderBackgroundBrush}" Padding="18,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="X-Plane 737NG Maintenance Toolkit" Foreground="{DynamicResource AppHeaderTextBrush}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ToolkitVersion}"
                                   Foreground="{DynamicResource AppHeaderSecondaryBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Target-neutral maintenance for supported Zibo and LevelUp 737NG aircraft" Foreground="{DynamicResource AppHeaderSecondaryBrush}"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Background="{DynamicResource AppLogoBackgroundBrush}"
                        CornerRadius="5"
                        Padding="8,4"
                        ClipToBounds="True"
                        VerticalAlignment="Center">
                    <Image Source="/Assets/wahltho_logo_horizontal_v2.jpg"
                           Width="360"
                           Height="78"
                           Stretch="UniformToFill"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                IsVisible="{Binding ApplicationUpdate.BannerVisible}"
                Background="{DynamicResource AppSelectionBrush}"
                BorderBrush="{DynamicResource AppBorderStrongBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding ApplicationUpdate.Title}" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="{Binding ApplicationUpdate.Status}"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Release notes" Command="{Binding ApplicationUpdate.OpenReleaseCommand}"/>
                    <Button Content="Later" Command="{Binding ApplicationUpdate.DismissCommand}" IsEnabled="{Binding !ApplicationUpdate.IsBusy}"/>
                    <Button Content="Download"
                            Classes="primary"
                            Command="{Binding ApplicationUpdate.DownloadCommand}"
                            IsVisible="{Binding ApplicationUpdate.DownloadVisible}"
                            IsEnabled="{Binding ActionsEnabled}"/>
                    <Button Content="Cancel"
                            Command="{Binding ApplicationUpdate.CancelCommand}"
                            IsVisible="{Binding ApplicationUpdate.CancelVisible}"/>
                    <Button Content="Restart and update"
                            Classes="primary"
                            Command="{Binding ApplicationUpdate.ApplyCommand}"
                            IsVisible="{Binding ApplicationUpdate.RestartVisible}"
                            IsEnabled="{Binding ActionsEnabled}"/>
                </StackPanel>
                <ProgressBar Grid.Row="1"
                             Grid.ColumnSpan="2"
                             IsVisible="{Binding ApplicationUpdate.ProgressVisible}"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ApplicationUpdate.Progress}"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Margin="16">
            <TabItem Header="Start">
                <Grid ColumnDefinitions="340,*" ColumnSpacing="16">
                    <ScrollViewer x:Name="InstallationPaneScroll" Grid.Column="0"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <Border x:Name="SelectedInstallationCard" Classes="status-card">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="label" Text="Detected product"/>
                                    <ComboBox ItemsSource="{Binding DetectedProductTargets}"
                                              SelectedItem="{Binding SelectedProduct}"
                                              IsVisible="{Binding ProductSelectorVisible}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProductTargetStatus">
                                                <StackPanel Spacing="2" Margin="0,3">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11"/>
                                                    <TextBlock Text="{Binding Variants}" Foreground="{DynamicResource AppTextTertiaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Classes="value"
                                               Text="{Binding SelectedProductName}"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding FixedProductVisible}"/>
                                    <TextBlock Text="{Binding SelectedProductDetail}" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedProductVariants}" Foreground="{DynamicResource AppTextTertiaryBrush}" TextWrapping="Wrap"/>
                                    <StackPanel Spacing="2" IsVisible="{Binding ProductFolderVisible}">
                                        <TextBlock Classes="label" Text="Product folder"/>
                                        <TextBlock Classes="path" Text="{Binding SelectedProductFolderPath}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Installation Folder" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Choose an X-Plane folder, Aircraft folder, or direct aircraft folder. Supported Zibo and LevelUp products are detected structurally."
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Spacing="8">
                                        <Button Content="Auto-detect"
                                                Command="{Binding AutoDetectCommand}"
                                                IsEnabled="{Binding CanAutoDetect}"
                                                Classes="primary"
                                                HorizontalAlignment="Stretch"/>
                                        <TextBlock Classes="label" Text="Selected folder"/>
                                        <TextBox Text="{Binding SelectedAircraftPath}" PlaceholderText="/path/to/X-Plane, Aircraft, Zibo, or LevelUp folder"/>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Button Grid.Column="0" Content="Browse" Click="BrowseAircraft_Click" HorizontalAlignment="Stretch"/>
                                            <Button Grid.Column="1"
                                                    Content="Scan selected folder"
                                                    Command="{Binding ScanCommand}"
                                                    HorizontalAlignment="Stretch"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Spacing="4" IsVisible="{Binding DetectedTargetsVisible}">
                                        <TextBlock Classes="label" Text="Auto-detected choices"/>
                                        <ComboBox ItemsSource="{Binding DetectedTargets}"
                                                  SelectedItem="{Binding SelectedCandidate}"
                                                  HorizontalAlignment="Stretch"
                                                  MaxDropDownHeight="320">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="core:AircraftCandidate">
                                                    <StackPanel Spacing="2" Margin="0,3">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Path}" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Column="1" RowDefinitions="Auto,*">
                        <Border x:Name="OperationProgressPanel" Grid.Row="0" Classes="operation-card"
                                Padding="14" Margin="0,0,0,12" IsVisible="{Binding OperationPanelVisible}">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding OperationTitle}" Foreground="#F8FAFC"
                                                   FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   MaxLines="2" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding OperationTitle}"/>
                                        <TextBlock Text="{Binding OperationSubtitle}" Foreground="#C4B5FD"
                                                   FontSize="12" TextWrapping="Wrap" MaxLines="2"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OperationSubtitle}"/>
                                    </StackPanel>
                                    <Button x:Name="OperationCancelButton" Grid.Column="1" Content="Cancel"
                                            Command="{Binding CancelOperationCommand}"
                                            IsVisible="{Binding CanCancelOperation}" IsEnabled="{Binding CanCancelOperation}"
                                            Background="#7F1D1D" Foreground="#FFFFFF" VerticalAlignment="Top"/>
                                </Grid>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding OperationProgress}"
                                             Height="10" Background="#2E1065" Foreground="#BDEB73" CornerRadius="5"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Text="{Binding OperationStatus}" Foreground="#BDEB73" FontWeight="SemiBold"
                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding OperationStatus}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OperationElapsed, StringFormat='Elapsed {0}'}"
                                               Foreground="#F8FAFC" VerticalAlignment="Top"/>
                                </Grid>
                                <TextBlock Text="{Binding OperationProgressText}" Foreground="#DDD6FE" FontSize="12"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding OperationProgressText}"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer x:Name="FunctionsPaneScroll" Grid.Row="1"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16">
                                <Expander x:Name="OperationLogExpander" Header="Operation log" IsExpanded="False"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          IsVisible="{Binding OperationPanelVisible}">
                                    <Border Classes="console-card">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="{Binding OperationSubtitle}" Foreground="#C4B5FD" TextWrapping="Wrap"/>
                                            <TextBox x:Name="OperationLogText" Text="{Binding OperationLog}"
                                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                     FontFamily="Menlo,Consolas,monospace" Foreground="#E9D5FF"
                                                     Background="#10072C" BorderThickness="0" Height="180"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                                    <Border Grid.Row="0"
                                            Classes="task-card"
                                            IsVisible="{Binding FreshInstallVisible}">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Install New Aircraft" FontSize="18" FontWeight="SemiBold"/>
                                                <TextBlock Text="Installs a complete Zibo or LevelUp aircraft into an unused folder under the selected X-Plane 12 installation. Packages are staged and structurally validated before activation."
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <Grid Grid.Row="1" ColumnDefinitions="220,*,Auto" ColumnSpacing="14">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Classes="label" Text="Product"/>
                                                    <ComboBox ItemsSource="{Binding FreshInstallProducts}"
                                                              SelectedItem="{Binding SelectedFreshInstallProduct}"
                                                              HorizontalAlignment="Stretch">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="upstream:AircraftFreshInstallProduct">
                                                                <TextBlock Text="{Binding DisplayName}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Classes="label" Text="New aircraft folder"/>
                                                    <TextBox Text="{Binding FreshInstallTargetPath}"/>
                                                    <TextBlock Classes="path"
                                                               Text="{Binding FreshInstallXPlaneRoot, StringFormat='X-Plane: {0}'}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Spacing="3" MinWidth="130">
                                                    <TextBlock Classes="label" Text="Available"/>
                                                    <TextBlock Text="{Binding FreshInstallAvailableVersion}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                                <TextBlock Text="{Binding FreshInstallStatus}"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"/>
                                                <WrapPanel Grid.Column="1" ItemSpacing="8" LineSpacing="8">
                                                    <Button Content="Check package"
                                                            Command="{Binding CheckFreshInstallPackageCommand}"
                                                            IsEnabled="{Binding CanImportFreshInstallPackage}"/>
                                                    <Button Content="Import package"
                                                            Click="ImportFreshInstallPackage_Click"
                                                            IsEnabled="{Binding CanImportFreshInstallPackage}"/>
                                                    <Button Content="Install"
                                                            Classes="primary"
                                                            Command="{Binding InstallFreshAircraftCommand}"
                                                            IsEnabled="{Binding CanInstallFreshAircraft}"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1" Classes="task-card">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Updates" FontSize="18" FontWeight="SemiBold"/>
                                                <TextBlock Text="Checks aircraft and VNAV package state, then applies each approved transaction with its own backup."
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="16">
                                                <StackPanel Spacing="9">
                                                    <TextBlock Text="Aircraft package" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding UpstreamUpdateSummary}" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Classes="label" Text="Installed"/>
                                                            <TextBlock Text="{Binding UpstreamLocalVersion}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Classes="label" Text="Available"/>
                                                            <TextBlock Text="{Binding UpstreamAvailableVersion}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Classes="label" Text="Plan"/>
                                                        <TextBlock Text="{Binding UpstreamPlanAction}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding UpstreamActionStatus}" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <Border Grid.Column="1"
                                                        Width="1"
                                                        Background="{DynamicResource AppBorderBrush}"
                                                        Margin="2,0"/>

                                                <StackPanel Grid.Column="2" Spacing="9">
                                                    <TextBlock Text="{Binding MaintenancePatchTitle}" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Required package status for the selected aircraft. Individual package versions and controls are listed below."
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Classes="label" Text="Status"/>
                                                        <TextBlock Text="{Binding MaintenancePatchSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding MaintenancePatchDetail}"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>

                                            <WrapPanel Grid.Row="2" ItemSpacing="8" LineSpacing="8">
                                                <Button Content="Update"
                                                        Classes="primary"
                                                        Command="{Binding UpdateAircraftPackagesCommand}"
                                                        IsVisible="{Binding UnifiedUpdateVisible}"
                                                        IsEnabled="{Binding ProductActionsEnabled}"/>
                                                <Button Content="Import package"
                                                        Click="ImportAircraftUpdatePackage_Click"
                                                        IsEnabled="{Binding CanImportAircraftUpdatePackage}"/>
                                                <Button Content="Restore aircraft"
                                                        Command="{Binding RestoreAircraftUpdateCommand}"
                                                        IsEnabled="{Binding CanRestoreAircraftUpdate}"/>
                                                <Button Content="Restore VNAV"
                                                        Command="{Binding RunPackageActionCommand}"
                                                        CommandParameter="Restore"
                                                        IsEnabled="{Binding ProductActionsEnabled}"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="2"
                                            Classes="task-card"
                                            IsVisible="{Binding ContentPackageOverviewVisible}">
                                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <StackPanel Spacing="4">
                                                <TextBlock Text="Components &amp; Aircraft Patches" FontSize="18" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Packages are filtered for the selected product. Optional packages remain separate from normal aircraft and VNAV updates."
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Check releases"
                                                        Command="{Binding CheckContentPackageCatalogCommand}"
                                                        IsEnabled="{Binding CanCheckContentPackageCatalog}"
                                                        VerticalAlignment="Top"/>
                                            </Grid>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding ContentPackageCatalogStatus}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       TextWrapping="Wrap"/>

                                            <ItemsControl Grid.Row="2" ItemsSource="{Binding AvailableContentPackages}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:AvailableContentPackageStatus">
                                                        <Border BorderBrush="{DynamicResource AppBorderBrush}"
                                                                BorderThickness="0,1,0,0"
                                                                Padding="0,12">
                                                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                                    <StackPanel Spacing="2">
                                                                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{Binding CategoryLabel}" Classes="label"/>
                                                                    </StackPanel>
                                                                    <WrapPanel Grid.Column="1" ItemSpacing="8" LineSpacing="8" VerticalAlignment="Center">
                                                                        <TextBlock Text="Managed in Updates"
                                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                                   VerticalAlignment="Center"
                                                                                   IsVisible="{Binding IsManaged}"/>
                                                                        <Button Content="Review"
                                                                                Click="ReviewCatalogPatch_Click"
                                                                                IsEnabled="{Binding CanAct}"
                                                                                IsVisible="{Binding IsOptional}"/>
                                                                        <Button Content="{Binding ActionLabel}"
                                                                                Classes="primary"
                                                                                Click="ApplyCatalogPatch_Click"
                                                                                IsEnabled="{Binding CanAct}"
                                                                                IsVisible="{Binding IsOptional}"/>
                                                                        <Button Content="Restore"
                                                                                Click="RestoreCatalogPatch_Click"
                                                                                IsEnabled="{Binding CanRestore}"
                                                                                IsVisible="{Binding IsOptional}"/>
                                                                        <Button Content="Remove"
                                                                                Click="RemoveCatalogPatch_Click"
                                                                                IsEnabled="{Binding CanRemove}"
                                                                                IsVisible="{Binding IsOptional}"/>
                                                                    </WrapPanel>
                                                                </Grid>
                                                                <TextBlock Grid.Row="1"
                                                                           Text="{Binding Description}"
                                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                           TextWrapping="Wrap"/>
                                                                <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="18">
                                                                    <StackPanel Spacing="2">
                                                                        <TextBlock Classes="label" Text="Installed"/>
                                                                        <TextBlock Text="{Binding InstalledVersion}" FontWeight="SemiBold"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                                        <TextBlock Classes="label" Text="Available"/>
                                                                        <TextBlock Text="{Binding AvailableVersion}" FontWeight="SemiBold"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" Spacing="2">
                                                                        <TextBlock Classes="label" Text="Status"/>
                                                                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="3"
                                            Classes="task-card"
                                            IsVisible="{Binding ToolPackageVisible}">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Components &amp; Tools" FontSize="18" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Optional aircraft components and X-Plane tools offered only for compatible detected products."
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="3" MinWidth="130">
                                                    <TextBlock Classes="label" Text="Component or tool"/>
                                                    <ComboBox ItemsSource="{Binding AvailableToolPackages}"
                                                              SelectedItem="{Binding SelectedToolPackage}"
                                                              MinWidth="190">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="content:ContentPackageCatalogEntry">
                                                                <TextBlock Text="{Binding DisplayName}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="3" MinWidth="130">
                                                    <TextBlock Classes="label" Text="Release channel"/>
                                                    <ComboBox ItemsSource="{Binding ToolReleaseChannelOptions}"
                                                              SelectedItem="{Binding SelectedToolReleaseChannel}"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Row="1" Spacing="3">
                                                <TextBlock Text="{Binding ToolPackageName}" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ToolPackageDescription}"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="22">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Classes="label" Text="Installed"/>
                                                    <TextBlock Text="{Binding ToolInstalledVersion}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Classes="label" Text="Available"/>
                                                    <TextBlock Text="{Binding ToolAvailableVersion}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="2">
                                                    <TextBlock Classes="label" Text="Status"/>
                                                    <TextBlock Text="{Binding ToolPackageStatus}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Classes="label" Text="{Binding ToolInstallScopeLabel}"/>
                                                    <TextBlock Classes="path" Text="{Binding ToolXPlaneRoot}"/>
                                                    <TextBlock Classes="label" Text="Installation target" Margin="0,5,0,0"/>
                                                    <TextBlock Classes="path" Text="{Binding ToolTargetPath}"/>
                                                </StackPanel>
                                                <WrapPanel Grid.Column="1"
                                                           ItemSpacing="8"
                                                           LineSpacing="8"
                                                           VerticalAlignment="Bottom">
                                                    <Button Content="Check release"
                                                            Command="{Binding CheckToolReleaseCommand}"
                                                            IsEnabled="{Binding CanCheckToolRelease}"/>
                                                    <Button Content="{Binding ToolActionLabel}"
                                                            Classes="primary"
                                                            Command="{Binding RunToolPackageCommand}"
                                                            IsEnabled="{Binding CanRunToolPackage}"/>
                                                    <Button Content="Restore"
                                                            Command="{Binding RestoreToolPackageCommand}"
                                                            IsEnabled="{Binding CanRestoreToolPackage}"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="4"
                                            Classes="task-card"
                                            IsVisible="{Binding ResourcePackageVisible}">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Resources" FontSize="18" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Optional verified resources for the selected product. Resources are extracted outside X-Plane and never modify aircraft files."
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="3" MinWidth="130">
                                                    <TextBlock Classes="label" Text="Resource"/>
                                                    <ComboBox ItemsSource="{Binding AvailableResourcePackages}"
                                                              SelectedItem="{Binding SelectedResourcePackage}"
                                                              MinWidth="190">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="content:ContentPackageCatalogEntry">
                                                                <TextBlock Text="{Binding DisplayName}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="3" MinWidth="130">
                                                    <TextBlock Classes="label" Text="Release channel"/>
                                                    <ComboBox ItemsSource="{Binding ResourceReleaseChannelOptions}"
                                                              SelectedItem="{Binding SelectedResourceReleaseChannel}"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Row="1" Spacing="3">
                                                <TextBlock Text="{Binding ResourcePackageName}" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ResourcePackageDescription}"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="22">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Classes="label" Text="Installed"/>
                                                    <TextBlock Text="{Binding ResourceDownloadedVersion}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Classes="label" Text="Available"/>
                                                    <TextBlock Text="{Binding ResourceAvailableVersion}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="2">
                                                    <TextBlock Classes="label" Text="Status"/>
                                                    <TextBlock Text="{Binding ResourcePackageStatus}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Classes="label" Text="Extraction location"/>
                                                    <TextBlock Classes="path"
                                                               Text="{Binding ResourceDestinationPath}"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Classes="label" Text="Installed folder" Margin="0,5,0,0"/>
                                                    <TextBlock Classes="path"
                                                               Text="{Binding ResourceFilePath}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Choose destination"
                                                        Click="BrowseResourceDestination_Click"
                                                        IsEnabled="{Binding ActionsEnabled}"
                                                        VerticalAlignment="Top"/>
                                            </Grid>

                                            <WrapPanel Grid.Row="4" ItemSpacing="8" LineSpacing="8">
                                                <Button Content="Check release"
                                                        Command="{Binding CheckResourceReleaseCommand}"
                                                        IsEnabled="{Binding CanCheckResourceRelease}"/>
                                                <Button Content="{Binding ResourceActionLabel}"
                                                        Classes="primary"
                                                        Command="{Binding DownloadResourcePackageCommand}"
                                                        IsEnabled="{Binding CanDownloadResourcePackage}"/>
                                                <Button Content="Verify"
                                                        Command="{Binding VerifyResourcePackageCommand}"
                                                        IsEnabled="{Binding CanVerifyResourcePackage}"/>
                                                <Button Content="Open folder"
                                                        Command="{Binding OpenResourceFolderCommand}"
                                                        IsEnabled="{Binding CanOpenResourceFolder}"/>
                                                <Button Content="Remove resource"
                                                        Command="{Binding RemoveResourcePackageCommand}"
                                                        IsEnabled="{Binding CanRemoveResourcePackage}"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="5"
                                            Classes="task-card"
                                            IsVisible="{Binding LiveryPackageVisible}">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Liveries" FontSize="18" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Optional verified liveries for the selected aircraft. Each livery is installed into this aircraft's liveries folder."
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="3" MinWidth="190">
                                                    <TextBlock Classes="label" Text="Livery"/>
                                                    <ComboBox ItemsSource="{Binding AvailableLiveryPackages}"
                                                              SelectedItem="{Binding SelectedLiveryPackage}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="content:ContentPackageCatalogEntry">
                                                                <TextBlock Text="{Binding DisplayName}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="3" MinWidth="130">
                                                    <TextBlock Classes="label" Text="Release channel"/>
                                                    <ComboBox ItemsSource="{Binding LiveryReleaseChannelOptions}"
                                                              SelectedItem="{Binding SelectedLiveryReleaseChannel}"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Row="1" Spacing="3">
                                                <TextBlock Text="{Binding LiveryPackageName}" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding LiveryPackageDescription}"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="22">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Classes="label" Text="Installed"/>
                                                    <TextBlock Text="{Binding LiveryInstalledVersion}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Classes="label" Text="Available"/>
                                                    <TextBlock Text="{Binding LiveryAvailableVersion}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="2">
                                                    <TextBlock Classes="label" Text="Status"/>
                                                    <TextBlock Text="{Binding LiveryPackageStatus}" TextWrapping="Wrap"/>
                                                    <TextBlock Classes="path" Text="{Binding LiveryTargetPath}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>

                                            <WrapPanel Grid.Row="3" ItemSpacing="8" LineSpacing="8">
                                                <Button Content="Check release"
                                                        Command="{Binding CheckLiveryReleaseCommand}"
                                                        IsEnabled="{Binding CanCheckLiveryRelease}"/>
                                                <Button Content="{Binding LiveryActionLabel}"
                                                        Classes="primary"
                                                        Command="{Binding InstallLiveryCommand}"
                                                        IsEnabled="{Binding CanInstallLivery}"/>
                                                <Button Content="Verify"
                                                        Command="{Binding VerifyLiveryCommand}"
                                                        IsEnabled="{Binding CanVerifyLivery}"/>
                                                <Button Content="Repair"
                                                        Command="{Binding RepairLiveryCommand}"
                                                        IsEnabled="{Binding CanRepairLivery}"/>
                                                <Button Content="Open folder"
                                                        Command="{Binding OpenLiveryFolderCommand}"
                                                        IsEnabled="{Binding CanOpenLiveryFolder}"/>
                                                <Button Content="Remove"
                                                        Command="{Binding RemoveLiveryCommand}"
                                                        IsEnabled="{Binding CanRemoveLivery}"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="6" Classes="task-card">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Views After CG Change" FontSize="18" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ViewUtilitySummary}" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Spacing="10">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Classes="label" Text="Target variant"/>
                                                    <ComboBox ItemsSource="{Binding FilteredViewVariants}"
                                                              SelectedItem="{Binding SelectedViewVariant}"
                                                              HorizontalAlignment="Stretch">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="aircraft:AircraftVariantViewAnalysis">
                                                                <StackPanel Spacing="2" Margin="0,3">
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Classes="label" Text="View status"/>
                                                    <TextBlock Text="{Binding ViewUtilityStatus}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Classes="label" Text="Quick View baseline"/>
                                                    <TextBlock Text="{Binding QuickViewBaselineStatus}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding QuickViewBaselineRecommendation}" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <WrapPanel Grid.Row="2" ItemSpacing="8" LineSpacing="8">
                                                <Button Content="Fix"
                                                        Classes="primary"
                                                        Command="{Binding AdaptQuickViewsForCgCommand}"
                                                        IsEnabled="{Binding CanAdaptQuickViewsForCg}"/>
                                                <Button Content="Adopt Current CG as Baseline"
                                                        Command="{Binding AdoptQuickViewBaselineCommand}"
                                                        IsEnabled="{Binding CanAdoptQuickViewBaseline}"/>
                                                <Button Content="Use Quick View 0 as Default Viewpoint"
                                                        Command="{Binding ApplyQv0ToDefaultViewCommand}"
                                                        IsEnabled="{Binding ProductActionsEnabled}"/>
                                                <Button Content="Copy Views to Other LevelUp Variants"
                                                        Command="{Binding CopyViewsToLevelUpFleetCommand}"
                                                        IsVisible="{Binding LevelUpFleetViewTransferVisible}"
                                                        IsEnabled="{Binding CanCopyViewsToLevelUpFleet}"
                                                        ToolTip.Tip="Copies the selected variant's Quick Views to the other LevelUp variants in this aircraft folder and corrects them for each CG."/>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Border Classes="card">
                                    <StackPanel Spacing="10" IsEnabled="{Binding ActionsEnabled}">
                                        <TextBlock Text="Hardware configurations" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Copy saved hardware settings between installed Zibo and LevelUp variants in the same X-Plane installation." TextWrapping="Wrap"/>
                                        <Button Content="Find hardware configurations" Command="{Binding FindHardwareConfigsCommand}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding HardwareConfigStatus}" TextWrapping="Wrap"/>
                                        <TextBlock Text="Copy from"/>
                                        <ComboBox ItemsSource="{Binding HardwareConfigSources}" SelectedItem="{Binding SelectedHardwareConfigSource}" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:HardwareConfigTargetOption"><TextBlock Text="{Binding Label}"/></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="Copy to (select destinations)"/>
                                        <ItemsControl ItemsSource="{Binding HardwareConfigTargets}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:HardwareConfigTargetOption"><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"/></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Content="Copy selected" Command="{Binding CopyHardwareConfigsCommand}" Margin="0,0,8,0"/>
                                            <Button Content="Restore last hardware copy" Command="{Binding RestoreHardwareConfigsCommand}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Advanced">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Text="Diagnostics and technical details" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Dump to file" Command="{Binding ExportLogCommand}"/>
                            <Button Grid.Column="2" Content="Clear" Command="{Binding ClearLogCommand}"/>
                        </Grid>

                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="Optional Patches" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding OptionalPatchName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding OptionalPatchStatus}"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding CompatibilityModules}"
                                                  IsVisible="{Binding CompatibilityModulesVisible}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CompatibilityModuleOptionViewModel">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,3">
                                                    <CheckBox IsChecked="{Binding IsSelected}"
                                                              IsEnabled="{Binding CanChangeSelection}"
                                                              VerticalAlignment="Top"/>
                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding PolicyLabel}"
                                                               Classes="label"
                                                               VerticalAlignment="Top"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Classes="path-display">
                                        <TextBlock Classes="path" Text="{Binding OptionalPatchPackagePath}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Bottom">
                                    <Button Content="Select package" Click="BrowseOptionalPatchPackage_Click" IsEnabled="{Binding ActionsEnabled}"/>
                                    <Button Content="Review"
                                            Command="{Binding ReviewOptionalPatchCommand}"
                                            IsEnabled="{Binding CanRunOptionalPatch}"/>
                                    <Button Content="Install / update"
                                            Command="{Binding RunOptionalPatchActionCommand}"
                                            CommandParameter="Update"
                                            IsEnabled="{Binding CanRunOptionalPatch}"/>
                                    <Button Content="Repair"
                                            Command="{Binding RunOptionalPatchActionCommand}"
                                            CommandParameter="Repair"
                                            IsEnabled="{Binding CanRunOptionalPatch}"/>
                                    <Button Content="Restore"
                                            Command="{Binding RunOptionalPatchActionCommand}"
                                            CommandParameter="Restore"
                                            IsEnabled="{Binding CanRunOptionalPatch}"/>
                                    <Button Content="Uninstall"
                                            Command="{Binding RunOptionalPatchActionCommand}"
                                            CommandParameter="Uninstall"
                                            IsEnabled="{Binding CanRunOptionalPatch}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Scan Summary" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StatusSummary}" TextWrapping="Wrap"/>
                                    <TextBlock Classes="label" Text="Target script"/>
                                    <TextBlock Text="{Binding TargetScriptPath}" FontFamily="Menlo,Consolas,monospace" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Classes="label" Text="Repository"/>
                                    <TextBlock Text="{Binding RepositoryUrl}" Foreground="{DynamicResource AppLinkBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Aircraft Update Details" FontSize="16" FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="label" Text="Mode"/>
                                            <TextBlock Text="{Binding UpstreamUpdateMode}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Classes="label" Text="Last checked"/>
                                            <TextBlock Text="{Binding UpstreamLastChecked}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Classes="label" Text="Plan"/>
                                            <TextBlock Text="{Binding UpstreamPlanAction}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Classes="label" Text="Source"/>
                                    <TextBlock Text="{Binding UpstreamSource}" Foreground="{DynamicResource AppLinkBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Classes="label" Text="Cache"/>
                                    <TextBlock Text="{Binding UpstreamCacheRoot}" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                                        <Button Content="Check updates"
                                                Command="{Binding RefreshAircraftUpdateCheckCommand}"
                                                IsEnabled="{Binding ActionsEnabled}"/>
                                        <Button Content="Download required packages"
                                                Command="{Binding DownloadAircraftUpdatePackagesCommand}"
                                                IsEnabled="{Binding CanDownloadAircraftUpdatePackage}"/>
                                        <Button Content="Review aircraft changes"
                                                Command="{Binding DryRunAircraftUpdateCommand}"
                                                IsEnabled="{Binding CanDryRunAircraftUpdatePackage}"/>
                                        <Button Content="Apply cached update"
                                                Command="{Binding ApplyAircraftUpdateCommand}"
                                                IsEnabled="{Binding CanApplyAircraftUpdatePackage}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="VNAV Components" FontSize="16" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding Components}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="analysis:ComponentStatus">
                                                <Grid ColumnDefinitions="220,100,90,*" ColumnSpacing="10" Margin="0,4">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding State}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Version}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Detail}" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                                        <Button Content="Review VNAV changes" Command="{Binding DryRunCommand}" IsEnabled="{Binding ActionsEnabled}"/>
                                        <Button Content="Install" Command="{Binding RunPackageActionCommand}" CommandParameter="Install" IsEnabled="{Binding ActionsEnabled}"/>
                                        <Button Content="Repair" Command="{Binding RunPackageActionCommand}" CommandParameter="Repair" IsEnabled="{Binding ActionsEnabled}"/>
                                        <Button Content="Uninstall" Command="{Binding RunPackageActionCommand}" CommandParameter="Uninstall" IsEnabled="{Binding ActionsEnabled}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="View Details" FontSize="16" FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="label" Text="Source"/>
                                            <TextBlock Text="{Binding QuickViewBaselineSource}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Classes="label" Text="Confidence"/>
                                            <TextBlock Text="{Binding QuickViewBaselineConfidence}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Classes="label" Text="Delta"/>
                                            <TextBlock Text="{Binding QuickViewBaselineDelta}" FontFamily="Menlo,Consolas,monospace" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding QuickViewBaselineDetail}" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                                        <Button Content="Create Config Backup"
                                                Command="{Binding CreateConfigBackupCommand}"
                                                IsEnabled="{Binding ActionsEnabled}"/>
                                        <Button Content="Restore Config Backup"
                                                Command="{Binding RestoreConfigBackupCommand}"
                                                IsEnabled="{Binding ActionsEnabled}"/>
                                        <Button Content="Restore Latest Backup"
                                                Command="{Binding RestoreLatestBackupCommand}"
                                                IsEnabled="{Binding ActionsEnabled}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Planned VNAV Changes" FontSize="16" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding PlannedChanges}"/>
                                    <TextBlock Text="Findings" FontSize="16" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding Findings}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Required Aircraft Packages" FontSize="16" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding UpstreamRequiredPackages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="upstream:AircraftUpdatePackage">
                                                <Grid ColumnDefinitions="130,90,*,*" ColumnSpacing="10" Margin="0,3">
                                                    <TextBlock Text="{Binding Kind}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Version}" FontFamily="Menlo,Consolas,monospace"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding FileName}" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SourceUrl}" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Package cache" FontSize="16" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding UpstreamPackageCacheEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="upstream:AircraftUpdatePackageCacheEntry">
                                                <Grid ColumnDefinitions="130,*,90,90,*" ColumnSpacing="10" Margin="0,3">
                                                    <TextBlock Text="{Binding State}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Package.FileName}" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Package.Version}" FontFamily="Menlo,Consolas,monospace"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SizeBytes}" FontFamily="Menlo,Consolas,monospace"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Sha256}" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Aircraft Package Review" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding UpstreamDryRunSummary}" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding UpstreamDryRunEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="upstream:AircraftUpdateDryRunEntry">
                                            <Grid ColumnDefinitions="150,*,90,*" ColumnSpacing="10" Margin="0,3">
                                                <TextBlock Text="{Binding Action}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" Text="{Binding RelativePath}" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SizeBytes}" FontFamily="Menlo,Consolas,monospace"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Detail}" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding UpstreamFindings}"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Detected View Variants" FontSize="16" FontWeight="SemiBold"/>
                                <ListBox ItemsSource="{Binding ViewVariants}"
                                         SelectedItem="{Binding SelectedViewVariant}"
                                         MaxHeight="430">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="aircraft:AircraftVariantViewAnalysis">
                                            <Border BorderBrush="{DynamicResource AppBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10"
                                                    Margin="0,4">
                                                <StackPanel Spacing="7">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding SourceRef}" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Classes="label" Text="Current CG"/>
                                                            <TextBlock Text="{Binding CurrentCgDisplay}" FontFamily="Menlo,Consolas,monospace" FontSize="12" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Classes="label" Text="Reference CG"/>
                                                            <TextBlock Text="{Binding ReferenceCgDisplay}" FontFamily="Menlo,Consolas,monospace" FontSize="12" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Classes="label" Text="Detected delta"/>
                                                        <TextBlock Text="{Binding DeltaDisplay}" FontFamily="Menlo,Consolas,monospace" FontSize="12" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                                        <TextBlock Text="{Binding IdentityStatus}" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding QuickViewStatus}" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding DefaultViewStatus}" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <ItemsControl ItemsSource="{Binding ViewFindings}"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                <TextBlock Text="Install Log" FontSize="16" FontWeight="SemiBold"/>
                                <TextBox Grid.Row="1"
                                         Text="{Binding InstallLog}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         FontFamily="Menlo,Consolas,monospace"
                                         MinHeight="180"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <Border Classes="card">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="Directory settings are validated before saving. Existing restore records keep their original absolute backup paths."
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource AppSurfaceMutedBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10">
                            <StackPanel Spacing="8" Margin="0,8,0,8">
                                <TextBlock Text="{Binding SettingsStatus}" Foreground="{DynamicResource AppTextTertiaryBrush}" TextWrapping="Wrap"/>
                                <CheckBox Content="Check aircraft and patch releases at startup"
                                          IsChecked="{Binding CheckAircraftAndPatchUpdatesOnStartup}"/>
                                <TextBlock Text="Populates available updates without installing anything. Manual checks remain available when disabled."
                                           TextWrapping="Wrap" Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                                <TextBlock Classes="label" Text="Toolkit application updates"/>
                                <CheckBox Content="Check for Toolkit updates at startup"
                                          IsChecked="{Binding CheckToolkitUpdatesOnStartup}"/>
                                <TextBlock Text="Show an Update / OK dialog when a new Toolkit version is available. This preference is saved automatically."
                                           TextWrapping="Wrap" Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                                <Button Content="Check for Toolkit updates now"
                                        Command="{Binding CheckToolkitUpdatesCommand}"
                                        IsEnabled="{Binding ActionsEnabled}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Data &amp; Backups" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Classes="label" Text="Backup folder"/>
                                <Border Classes="path-display">
                                    <TextBlock Classes="path" Text="{Binding BackupRootPath}"/>
                                </Border>
                                <TextBlock Classes="secondary-path" Text="{Binding DefaultBackupRootPath}"/>
                                <WrapPanel ItemSpacing="8" LineSpacing="8">
                                    <Button Content="Browse" Click="BrowseBackupRoot_Click" IsEnabled="{Binding ActionsEnabled}"/>
                                    <Button Content="Save" Command="{Binding SaveBackupSettingsCommand}" IsEnabled="{Binding ActionsEnabled}"/>
                                    <Button Content="Use Default" Command="{Binding UseDefaultBackupSettingsCommand}" IsEnabled="{Binding ActionsEnabled}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Package Sources" FontSize="16" FontWeight="SemiBold"/>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="label" Text="Downloaded package cache folder"/>
                                    <Border Classes="path-display">
                                        <TextBlock Classes="path" Text="{Binding AircraftUpdateCacheRootPath}"/>
                                    </Border>
                                    <TextBlock Classes="secondary-path" Text="{Binding DefaultAircraftUpdateCacheRootPath}"/>
                                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                                        <Button Content="Browse" Click="BrowseAircraftUpdateCacheRoot_Click" IsEnabled="{Binding ActionsEnabled}"/>
                                        <Button Content="Save" Command="{Binding SaveAircraftUpdateCacheSettingsCommand}" IsEnabled="{Binding ActionsEnabled}"/>
                                        <Button Content="Use Default" Command="{Binding UseDefaultAircraftUpdateCacheSettingsCommand}" IsEnabled="{Binding ActionsEnabled}"/>
                                        <Button Content="Clear Cache" Command="{Binding ClearAircraftUpdateCacheCommand}" IsEnabled="{Binding ActionsEnabled}"/>
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="label" Text="Offline VNAV package folder"/>
                                    <Border Classes="path-display">
                                        <TextBlock Classes="path" Text="{Binding OfflinePackageRootPath}"/>
                                    </Border>
                                    <TextBlock Classes="secondary-path" Text="{Binding DefaultOfflinePackageRootPath}"/>
                                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                                        <Button Content="Browse" Click="BrowseOfflinePackageRoot_Click" IsEnabled="{Binding ActionsEnabled}"/>
                                        <Button Content="Save" Command="{Binding SaveOfflinePackageSettingsCommand}" IsEnabled="{Binding ActionsEnabled}"/>
                                        <Button Content="Use Default" Command="{Binding UseDefaultOfflinePackageSettingsCommand}" IsEnabled="{Binding ActionsEnabled}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Diagnostics" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Classes="label" Text="Diagnostics export folder"/>
                                <Border Classes="path-display">
                                    <TextBlock Classes="path" Text="{Binding DiagnosticsExportRootPath}"/>
                                </Border>
                                <TextBlock Classes="secondary-path" Text="{Binding DefaultDiagnosticsExportRootPath}"/>
                                <WrapPanel ItemSpacing="8" LineSpacing="8">
                                    <Button Content="Browse" Click="BrowseDiagnosticsExportRoot_Click" IsEnabled="{Binding ActionsEnabled}"/>
                                    <Button Content="Save" Command="{Binding SaveDiagnosticsExportSettingsCommand}" IsEnabled="{Binding ActionsEnabled}"/>
                                    <Button Content="Use Default" Command="{Binding UseDefaultDiagnosticsExportSettingsCommand}" IsEnabled="{Binding ActionsEnabled}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Toolkit Files" FontSize="16" FontWeight="SemiBold"/>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="label" Text="Toolkit data folder"/>
                                    <TextBlock Classes="secondary-path" Text="{Binding ToolkitDataRoot}"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="label" Text="State file"/>
                                    <TextBlock Classes="secondary-path" Text="{Binding ToolkitStatePath}"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="label" Text="Settings file"/>
                                    <TextBlock Classes="secondary-path" Text="{Binding ToolkitSettingsPath}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
